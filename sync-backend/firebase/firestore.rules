// Règles de sécurité Firestore — collections "articles", "products", "orders"
// À copier dans Firebase Console → Firestore Database → Règles.
//
// - articles / products : lecture publique (contenu du site), écriture
//   réservée à un utilisateur authentifié (vous, via Firebase Auth).
// - orders : écriture publique autorisée (un client anonyme doit pouvoir
//   créer sa commande depuis le site), mais lecture réservée à un
//   utilisateur authentifié (vous, dans l'espace admin) pour protéger
//   les coordonnées des clients.
//
// Adaptez selon vos besoins réels avant mise en production.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /articles/{slug} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /products/{slug} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /orders/{ref} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
